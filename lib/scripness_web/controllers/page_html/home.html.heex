<Layouts.app flash={@flash}>
  <section class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="space-y-6 rounded-[32px] border border-white/30 bg-white/70 p-8 shadow-[0_30px_80px_rgba(28,17,12,0.15)] backdrop-blur">
      <p class="text-xs uppercase tracking-[0.4em] text-[#7b4a2c]">
        Full-stack engineering, contract & freelance
      </p>
      <h1 class="text-4xl font-semibold text-[#1a0f09] sm:text-5xl">
        Software engineer with 13 years designing and delivering complete systems.
      </h1>
      <p class="text-lg text-[#3b2b22]">
        I work across the full stack — architecture, backend, frontend, infrastructure — and
        focus on shipping software that solves the actual problem. 80+ projects delivered across
        CRM, SaaS, and e-commerce as a contract and freelance developer.
      </p>
      <div class="flex flex-wrap gap-3 text-sm">
        <span class="rounded-full border border-[#c7b3a4] bg-white/60 px-4 py-2">
          System Architecture & Design
        </span>
        <span class="rounded-full border border-[#c7b3a4] bg-white/60 px-4 py-2">
          End-to-End Delivery
        </span>
        <span class="rounded-full border border-[#c7b3a4] bg-white/60 px-4 py-2">
          Technical Leadership
        </span>
        <span class="rounded-full border border-[#c7b3a4] bg-white/60 px-4 py-2">
          Agentic Development
        </span>
        <span class="rounded-full border border-[#c7b3a4] bg-white/60 px-4 py-2">
          Product-Oriented
        </span>
        <span class="rounded-full border border-[#c7b3a4] bg-white/60 px-4 py-2">
          Clear Communication
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-4 pt-2 text-sm">
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-600/30 bg-emerald-50/60 px-4 py-2 text-emerald-800">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          Available for contract engagements
        </span>
        <a
          href="mailto:mail@scripness.com"
          class="rounded-full bg-[#1a0f09] px-5 py-2 text-white transition hover:-translate-y-0.5 hover:bg-[#2b1a12]"
        >
          Email me
        </a>
        <a
          href="/assets/andrei-scripcaru-technical.pdf"
          class="rounded-full border border-[#1a0f09]/30 px-5 py-2 text-[#1a0f09] transition hover:border-[#1a0f09]"
        >
          Resume (PDF)
        </a>
        <a
          href="tel:+37378181261"
          class="rounded-full border border-[#1a0f09]/30 px-5 py-2 text-[#1a0f09] transition hover:border-[#1a0f09]"
        >
          +373-78-181-261
        </a>
      </div>
    </div>

    <div class="space-y-6">
      <div class="rounded-[28px] border border-white/30 bg-[#1a0f09]/90 p-6 text-white shadow-[0_20px_60px_rgba(28,17,12,0.2)]">
        <h3 class="text-xl font-semibold">Background</h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="text-white/60">Education</dt>
            <dd class="mt-0.5 text-white/90">
              Free International University of Moldova — Information Technology
            </dd>
          </div>
          <div>
            <dt class="text-white/60">Languages</dt>
            <dd class="mt-0.5 text-white/90">
              English (C2), Romanian (Native), Russian (Native)
            </dd>
          </div>
          <div>
            <dt class="text-white/60">Location</dt>
            <dd class="mt-0.5 text-white/90">Moldova</dd>
          </div>
          <div>
            <dt class="text-white/60">Work style</dt>
            <dd class="mt-0.5 text-white/90">Mostly contract, mostly remote</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="rounded-[32px] border border-white/30 bg-white/70 p-8 shadow-[0_30px_80px_rgba(28,17,12,0.12)]">
