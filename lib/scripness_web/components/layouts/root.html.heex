<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Andrei Scripcaru" suffix=" · Software Engineer">
      {assigns[:page_title]}
    </.live_title>
    <meta
      name="description"
      content="Andrei Scripcaru — senior full-stack software engineer focused on system architecture, agent-directed delivery, whole-system review, debugging, and verification."
    />

    <%!-- Open Graph --%>
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="Andrei Scripcaru · Software Engineer" />
    <meta
      property="og:description"
      content="Senior full-stack software engineer focused on system architecture, agent-directed delivery, whole-system review, debugging, and verification."
    />
    <meta property="og:url" content="https://scripness.com/" />
    <meta property="og:image" content="https://scripness.com/images/og-image.png" />
    <meta property="og:site_name" content="Andrei Scripcaru" />
    <meta property="og:locale" content="en_US" />

    <%!-- Twitter/X Card --%>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Andrei Scripcaru · Software Engineer" />
    <meta
      name="twitter:description"
      content="Senior full-stack software engineer focused on system architecture, agent-directed delivery, whole-system review, debugging, and verification."
    />
    <meta name="twitter:image" content="https://scripness.com/images/og-image.png" />

    <%!-- Canonical + Icons --%>
    <link rel="canonical" href="https://scripness.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <%!-- Structured Data --%>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "dateModified": "2026-08-12",
        "mainEntity": {
          "@type": "Person",
          "name": "Andrei Scripcaru",
          "jobTitle": "Senior Full Stack Software Engineer",
          "url": "https://scripness.com",
          "email": "mail@scripness.com",
          "telephone": "+37378181261",
          "description": "Senior full-stack software engineer focused on system architecture, agent-directed delivery, whole-system review, debugging, and verification.",
          "knowsAbout": ["System Architecture", "Full-Stack Engineering", "Agent-Directed Delivery", "Specification-Driven Delivery", "Code Review", "Root-Cause Debugging", "Software Verification", "TypeScript", "NestJS", "Next.js", "PostgreSQL"],
          "sameAs": [
            "https://github.com/scripness"
          ]
        }
      }
    </script>

    <%!-- Analytics --%>
    <script async src="https://plausible.io/js/pa-r3z74vUP-5yOjA9LYStUS.js">
    </script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        document.documentElement.classList.add("antialiased");
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
